# Port API (slucha tylko na 127.0.0.1). Polaczenie z MongoDB bierze z .env biblioteki VoltAPI SDK.
PORT=3300
# Sekret strony: naglowek "Authorization: Bearer <SITE_API_SECRET>" przy kazdym zapytaniu (ten sam w .env.local strony).
SITE_API_SECRET=
# Aplikacja Discord (OAuth2) do logowania na stronach rekrutacji i panelu; adresy powrotu dodaj w OAuth2 -> Redirects.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
